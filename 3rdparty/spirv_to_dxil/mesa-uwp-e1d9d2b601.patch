+/* The compact root-constant ABI must never compile reads of the fork's extra
+ * raster/viewport tables. Binding chasing is the same helper used by NIR's UBO passes. */
+static bool
+compact_runtime_valid(nir_shader *nir, const struct dxil_spirv_runtime_conf *conf)
+{
+   if (!conf->compact_vertex_runtime_data || nir->info.stage == MESA_SHADER_COMPUTE)
+      return true;
+   if (conf->split_viewport_sizes)
+      return false;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *load = nir_instr_as_intrinsic(instr);
+            if (load->intrinsic != nir_intrinsic_load_ubo &&
+                load->intrinsic != nir_intrinsic_load_ubo_vec4)
+               continue;
+            nir_binding binding = nir_chase_binding(load->src[0]);
+            if (!binding.success || binding.desc_set != conf->runtime_data_cbv.register_space ||
+                binding.binding != conf->runtime_data_cbv.base_shader_register)
+               continue;
+            uint64_t base = nir_intrinsic_range_base(load);
+            uint64_t bytes = nir_intrinsic_range(load);
+            if (nir_src_is_const(load->src[1])) {
+               base = nir_src_as_uint(load->src[1]);
+               if (load->intrinsic == nir_intrinsic_load_ubo_vec4)
+                  base = base * 16 + nir_intrinsic_component(load) * load->def.bit_size / 8;
+               bytes = load->def.num_components * load->def.bit_size / 8;
+            }
+            if (base > DXIL_SPIRV_COMPACT_VERTEX_RUNTIME_SIZE ||
+                bytes > DXIL_SPIRV_COMPACT_VERTEX_RUNTIME_SIZE - base)
+               return false;
+         }
+      }
+   }
+   return true;
+}
+
+static bool
+nir_stage_to_dxil(nir_shader *nir, const struct dxil_spirv_runtime_conf *conf,
+                  enum dxil_validator_version validator_version_max,
+                  const struct dxil_spirv_logger *logger,
+                  struct dxil_spirv_object *out_dxil)
+{
+   if (!compact_runtime_valid(nir, conf)) {
+      if (logger && logger->log)
+         logger->log(logger->priv, "Shader requires data outside the compact vertex runtime ABI.\n");
+      return false;
+   }
+   struct nir_to_dxil_options opts = {
+      .environment = DXIL_ENVIRONMENT_VULKAN,
+      .lower_int16 = conf->lower_16bit_ops,
+      .shader_model_max = conf->shader_model_max,
+      .validator_version_max = validator_version_max,
+      .tessellation_input_control_points = conf->tessellation_input_control_points,
+   };
+
+   struct dxil_logger logger_inner = {.priv = logger->priv,
+                                      .log = logger->log};
+
+   struct blob dxil_blob;
+   if (!nir_to_dxil(nir, &opts, &logger_inner, &dxil_blob)) {
+      if (dxil_blob.allocated)
+         blob_finish(&dxil_blob);
+      return false;
+   }
+
+   blob_finish_get_buffer(&dxil_blob, &out_dxil->binary.buffer,
+                          &out_dxil->binary.size);
+   return true;
+}
